# ITMS API configuration (all optional; defaults shown)

# HTTP server
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# SUMO
# Path to the SUMO executable. Defaults to "sumo" resolved via PATH.
# SUMO_BINARY=C:\Program Files\Eclipse Sumo\bin\sumo.exe
SUMO_STEP_LENGTH_S=1
# Wall-clock milliseconds between simulation steps (1000 = real-time at 1s steps)
SUMO_STEP_INTERVAL_MS=1000
# Per-attempt TCP connection timeout for the TraCI socket (ms)
SUMO_CONNECT_TIMEOUT_MS=15000
# Total time allowed for SUMO startup + TraCI handshake (ms)
SUMO_STARTUP_TIMEOUT_MS=60000

# Scenario overrides (defaults point to simulation/sumo/scenarios/<id>/<id>.sumocfg)
# ITMS_SCENARIO_BASELINE=D:\SISTECH ITMS\simulation\sumo\scenarios\baseline\baseline.sumocfg
# ITMS_SCENARIO_EMERGENCY=D:\SISTECH ITMS\simulation\sumo\scenarios\emergency\emergency.sumocfg

# PostgreSQL + PostGIS (required from Phase 2 on)
# docker compose --env-file docker/.env up -d db
DATABASE_URL=postgres://itms:secret@127.0.0.1:5432/itms

# Traffic intelligence
# Persist snapshots every N collection ticks (default 5 = every 5 s at 1 s steps)
TRAFFIC_PERSIST_EVERY_TICKS=5
# Minimum wall-clock interval between WebSocket broadcasts (ms)
TRAFFIC_EVENT_INTERVAL_MS=1000
# Age (seconds) after which traffic data is reported stale
TRAFFIC_STALE_AFTER_SECONDS=5

# Congestion thresholds (defaults shown; occupancy/speed ratio are 0..1 fractions)
# TRAFFIC_CONGESTION_MEDIUM_OCCUPANCY=0.15
# TRAFFIC_CONGESTION_HIGH_OCCUPANCY=0.3
# TRAFFIC_CONGESTION_CRITICAL_OCCUPANCY=0.45
# TRAFFIC_CONGESTION_MEDIUM_SPEED_RATIO=0.6
# TRAFFIC_CONGESTION_HIGH_SPEED_RATIO=0.35
# TRAFFIC_CONGESTION_CRITICAL_SPEED_RATIO=0.15
# TRAFFIC_CONGESTION_MEDIUM_QUEUE=2
# TRAFFIC_CONGESTION_HIGH_QUEUE=6
# TRAFFIC_CONGESTION_CRITICAL_QUEUE=12
