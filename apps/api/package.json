{
  "name": "@itms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ITMS backend: simulation control via SUMO TraCI and REST APIs",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
