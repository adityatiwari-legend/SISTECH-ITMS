    "proj4": "^2.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.5.6",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
