{
  "name": "itms",
  "version": "0.1.0",
  "private": true,
  "description": "ITMS - Intelligent Traffic Management System with Predictive Rolling Green Corridor",
  "workspaces": [
    "apps/*",
    "packages/*",
    "SISTECH-IOTDISPLAY"
  ],
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build:network": "node simulation/sumo/scripts/build-network.mjs",
    "fetch:city": "node simulation/sumo/scripts/fetch-city-osm.mjs",
    "build:city-network": "node simulation/sumo/scripts/build-city-network.mjs",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "dev:iot": "npm run dev --workspace sistech-iotdisplay",
    "build:iot": "npm run build --workspace sistech-iotdisplay",
    "typecheck": "npm run typecheck --workspace apps/api && npm run typecheck --workspace @itms/types && npm run typecheck --workspace web && npm run typecheck --workspace sistech-iotdisplay",
    "test:api": "npm run test --workspace apps/api",
    "test:prediction": "python -m pytest services/prediction/tests -q",
    "migrate": "npm run migrate --workspace apps/api",
    "db:migrate": "npm run migrate --workspace apps/api"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "pg": "^8.23.0"
  }
}
